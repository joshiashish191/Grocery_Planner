<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->


    <style name="Theme.GroceryPlanner" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorTertiary">@color/colorAccent</item>
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorOnSecondary">@color/white</item>
    </style>

    <style name="plan_title">
        <item name="android:textSize">30sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="grocery_item_title">
        <item name="android:textSize">25sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="screen_title" parent="grocery_item_title">
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">40sp</item>
    </style>

    <style name="grocery_item_subtitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="mini_title">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="mini_title_with_color" parent="mini_title">
        <item name="android:textColor">@color/colorPrimaryDark</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="screen_mini_title">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/colorPrimary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="secondary_btn" parent="Widget.MaterialComponents.Button.OutlinedButton.Icon" />
    <style name="primary_btn" parent="Widget.MaterialComponents.Button" />

    <style name="Theme.CustomSplashScreenTheme" parent="Theme.SplashScreen">
        <item name="android:windowBackground">@color/colorPrimary</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/temp_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.GroceryPlanner</item>
    </style>
</resources>