<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".view.AboutAppFragment">

        <ImageView
            android:id="@+id/app_icon"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_marginTop="32dp"
            android:src="@drawable/app_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/app_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toBottomOf="@id/app_icon"
            style="@style/grocery_item_title"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary" />

        <TextView
            android:id="@+id/app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TextView"
            app:layout_constraintTop_toBottomOf="@+id/app_name"
            tools:layout_editor_absoluteX="194dp"
            app:layout_constraintStart_toStartOf="@id/app_icon"
            app:layout_constraintEnd_toEndOf="@id/app_icon"
            android:layout_marginTop="5dp"
            tools:text="V 1.0"
            style="@style/mini_title" />

        <TextView
            android:id="@+id/softglobe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:text="2024 Softglobe Technologies"
            app:layout_constraintBottom_toBottomOf="parent"
            android:gravity="center_horizontal"
            style="@style/mini_title"
            android:layout_marginBottom="5dp"/>

        <TextView
            android:id="@+id/rate_us"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="  Rate us"
            app:layout_constraintTop_toBottomOf="@+id/app_version"
            android:layout_marginStart="20dp"
            style="@style/grocery_item_title"
            app:drawableStartCompat="@drawable/rating_icon"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/colorPrimaryDark"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/divider_line_1"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@color/black"
            app:layout_constraintTop_toBottomOf="@id/rate_us"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>

        <TextView
            android:id="@+id/contact"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="  Contact"
            app:layout_constraintTop_toBottomOf="@+id/divider_line_1"
            android:layout_marginStart="20dp"
            style="@style/grocery_item_title"
            app:drawableStartCompat="@drawable/email_icon"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/colorPrimaryDark"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/divider_line_2"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:background="@color/black"
            app:layout_constraintTop_toBottomOf="@id/contact"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"/>

        <TextView
            android:id="@+id/privacy_policy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="  Privacy policy"
            app:layout_constraintTop_toBottomOf="@+id/divider_line_2"
            android:layout_marginStart="20dp"
            style="@style/grocery_item_title"
            app:drawableStartCompat="@drawable/lock_icon"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:textColor="@color/colorPrimaryDark"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackground"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>