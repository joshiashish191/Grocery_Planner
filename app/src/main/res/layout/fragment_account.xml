<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".view.AccountFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="8dp"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/account_txt_title"
                style="@style/grocery_item_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:text="Account"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/plan_txt_subtitle"
                style="@style/mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Plan"
                app:layout_constraintTop_toBottomOf="@+id/account_txt_title" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_plan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/plan_txt_subtitle">

                <TextView
                    android:id="@+id/txt_plan_name"
                    style="@style/grocery_item_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    tools:drawableStartCompat="@drawable/star_icon"
                    tools:text="  Sparkle Plan" />

                <TextView
                    android:id="@+id/txt_upgrade_plan"
                    style="@style/mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    app:layout_constraintTop_toBottomOf="@id/txt_plan_name"
                    tools:text="@string/upgrade_plan_description" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/divider_line_0"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/black"
                app:layout_constraintTop_toBottomOf="@id/cl_plan" />

            <TextView
                android:id="@+id/profile_txt_subtitle"
                style="@style/mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Profile"
                app:layout_constraintTop_toBottomOf="@+id/cl_plan" />

            <TextView
                android:id="@+id/txt_name"
                style="@style/grocery_item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:focusable="true"
                app:drawableEndCompat="@drawable/edit_pen_icon"
                app:layout_constraintTop_toBottomOf="@id/profile_txt_subtitle"
                tools:text="User Name" />

            <TextView
                android:id="@+id/divider_line_1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/black"
                app:layout_constraintTop_toBottomOf="@id/txt_name" />

            <TextView
                android:id="@+id/txt_email"
                style="@style/grocery_item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:focusable="true"
                android:text="email@example.com"
                app:layout_constraintTop_toBottomOf="@id/divider_line_1" />

            <TextView
                android:id="@+id/divider_line_2"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/black"
                app:layout_constraintTop_toBottomOf="@id/txt_email" />

            <TextView
                android:id="@+id/backup_txt_subtitle"
                style="@style/mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Backups"
                app:layout_constraintTop_toBottomOf="@id/divider_line_2" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_import_backup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/backup_txt_subtitle">

                <TextView
                    android:id="@+id/txt_import_backup"
                    style="@style/grocery_item_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:drawableStart="@drawable/import_backup_icon"
                    android:focusable="true"
                    android:text="  Import Backup"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/import_description"
                    style="@style/mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/import_description"
                    app:layout_constraintTop_toBottomOf="@id/txt_import_backup" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/divider_line_3"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/black"
                app:layout_constraintTop_toBottomOf="@id/cl_import_backup" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_export_backup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_constraintTop_toBottomOf="@id/divider_line_3">

                <TextView
                    android:id="@+id/txt_export_backup"
                    style="@style/grocery_item_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:clickable="true"
                    android:drawableStart="@drawable/export_backup_icon"
                    android:focusable="true"
                    android:text="  Export Backup"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/export_description"
                    style="@style/mini_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/export_description"
                    app:layout_constraintTop_toBottomOf="@id/txt_export_backup" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/divider_line_4"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/black"
                app:layout_constraintTop_toBottomOf="@id/cl_export_backup" />

            <TextView
                android:id="@+id/settings_txt_subtitle"
                style="@style/mini_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Settings"
                app:layout_constraintTop_toBottomOf="@id/divider_line_4" />

            <TextView
                android:id="@+id/txt_change_password"
                style="@style/grocery_item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:clickable="true"
                android:drawableStart="@drawable/password_icon"
                android:focusable="true"
                android:text="  Change Password"
                app:layout_constraintTop_toBottomOf="@id/settings_txt_subtitle" />

            <TextView
                android:id="@+id/divider_line_5"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:background="@color/black"
                app:layout_constraintTop_toBottomOf="@id/txt_change_password" />

            <TextView
                android:id="@+id/txt_logout"
                style="@style/grocery_item_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:clickable="true"
                android:drawableStart="@drawable/logout_icon"
                android:focusable="true"
                android:text="  Logout"
                app:layout_constraintTop_toBottomOf="@id/divider_line_5" />

            <TextView
                android:id="@+id/divider_line_6"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="5dp"
                android:background="@color/black"
                app:layout_constraintTop_toBottomOf="@id/txt_logout" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</layout>