<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".ForgotPasswordFragment"
        android:layout_margin="8dp">

        <TextView
            android:id="@+id/title_forgot_pass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forgot Password"
            style="@style/grocery_item_title"
            android:gravity="center_horizontal"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:layout_marginTop="32dp"
            android:id="@+id/enter_email_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/title_forgot_pass"
            android:text="Enter email below and we will send you one time code to reset your password"
            style="@style/grocery_item_subtitle"/>

        <EditText
            android:id="@+id/et_enter_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ems="10"
            android:hint="Enter email"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@id/enter_email_text" />

        <Button
            android:id="@+id/submit_email_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Submit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_enter_email" />

        <TextView
            android:layout_marginTop="20dp"
            android:id="@+id/mail_sent_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toBottomOf="@id/submit_email_btn"
            android:text="Email sent successfully. Please check your inbox and enter one time code below."
            style="@style/grocery_item_subtitle"
            android:visibility="gone"
            tools:visibility="visible"/>

        <EditText
            android:id="@+id/et_code"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:ems="10"
            android:hint="Enter one time code"
            android:inputType="textEmailAddress"
            app:layout_constraintTop_toBottomOf="@id/mail_sent_text"
            android:visibility="gone"
            tools:visibility="visible"/>

        <Button
            android:id="@+id/submit_code_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Submit"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/et_code"
            android:visibility="gone"
            tools:visibility="visible"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>