<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/navigation"
    app:startDestination="@id/groceryListFragment">

    <fragment
        android:id="@+id/groceryListFragment"
        android:name="net.softglobe.groceryplanner.view.GroceryListFragment"
        android:label="fragment_grocery_list"
        tools:layout="@layout/fragment_grocery_list" >
        <action
            android:id="@+id/action_groceryListFragment_to_addGroceryFragment"
            app:destination="@id/addGroceryFragment" />
        <action
            android:id="@+id/action_groceryListFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
        <action
            android:id="@+id/action_groceryListFragment_to_accountFragment"
            app:destination="@id/accountFragment" />
        <action
            android:id="@+id/action_groceryListFragment_to_aboutAppFragment"
            app:destination="@id/aboutAppFragment" />
    </fragment>
    <fragment
        android:id="@+id/addGroceryFragment"
        android:name="net.softglobe.groceryplanner.view.AddGroceryFragment"
        android:label="fragment_add_grocery"
        tools:layout="@layout/fragment_add_grocery" >
        <action
            android:id="@+id/action_addGroceryFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/addGroceryFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_addGroceryFragment_to_upgradePlanFragment"
            app:destination="@id/upgradePlanFragment" />
    </fragment>
    <fragment
        android:id="@+id/loginFragment"
        android:name="net.softglobe.groceryplanner.view.LoginFragment"
        android:label="LoginFragment" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
        <action
            android:id="@+id/action_loginFragment_to_forgotPasswordFragment"
            app:destination="@id/forgotPasswordFragment" />
        <action
            android:id="@+id/action_loginFragment_to_accountFragment"
            app:destination="@id/accountFragment"
            app:launchSingleTop="false"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="net.softglobe.groceryplanner.view.RegisterFragment"
        android:label="RegisterFragment" >
        <action
            android:id="@+id/action_registerFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/groceryListFragment" />
    </fragment>
    <fragment
        android:id="@+id/forgotPasswordFragment"
        android:name="net.softglobe.groceryplanner.view.ForgotPasswordFragment"
        android:label="ForgotPasswordFragment" >
        <action
            android:id="@+id/action_forgotPasswordFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />
    </fragment>
    <fragment
        android:id="@+id/changePasswordFragment"
        android:name="net.softglobe.groceryplanner.view.ChangePasswordFragment"
        android:label="ChangePasswordFragment" >
        <action
            android:id="@+id/action_changePasswordFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_changePasswordFragment_to_accountFragment"
            app:destination="@id/accountFragment"
            app:popUpTo="@id/groceryListFragment" />
    </fragment>
    <fragment
        android:id="@+id/accountFragment"
        android:name="net.softglobe.groceryplanner.view.AccountFragment"
        android:label="AccountFragment" >
        <action
            android:id="@+id/action_accountFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/accountFragment"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_accountFragment_to_changePasswordFragment"
            app:destination="@id/changePasswordFragment" />
        <action
            android:id="@+id/action_accountFragment_to_upgradePlanFragment"
            app:destination="@id/upgradePlanFragment" />
        <action
            android:id="@+id/action_accountFragment_to_upgradePlanWithCoinsFragment"
            app:destination="@id/upgradePlanWithCoinsFragment" />
    </fragment>
    <fragment
        android:id="@+id/upgradePlanFragment"
        android:name="net.softglobe.groceryplanner.view.UpgradePlanFragment"
        android:label="UpgradePlanFragment" >
        <action
            android:id="@+id/action_upgradePlanFragment_to_paymentSuccessFragment"
            app:destination="@id/paymentSuccessFragment"
            app:popUpTo="@id/groceryListFragment" />
    </fragment>
    <fragment
        android:id="@+id/paymentSuccessFragment"
        android:name="net.softglobe.groceryplanner.view.PaymentSuccessFragment"
        android:label="fragment_payment_success"
        tools:layout="@layout/fragment_payment_success" />
    <fragment
        android:id="@+id/aboutAppFragment"
        android:name="net.softglobe.groceryplanner.view.AboutAppFragment"
        android:label="fragment_about_app"
        tools:layout="@layout/fragment_about_app" />
    <fragment
        android:id="@+id/upgradePlanWithCoinsFragment"
        android:name="net.softglobe.groceryplanner.view.UpgradePlanWithCoinsFragment"
        android:label="UpgradePlanWithCoinsFragment" >
        <action
            android:id="@+id/action_upgradePlanWithCoinsFragment_to_paymentSuccessFragment"
            app:destination="@id/paymentSuccessFragment"
            app:popUpTo="@id/groceryListFragment" />
    </fragment>
</navigation>